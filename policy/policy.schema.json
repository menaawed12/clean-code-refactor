{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/menaawed12/clean-code-refactor/policy/policy.schema.json",
  "title": "clean-code-refactor policy",
  "description": "Organization or project policy for the clean-code-refactor skill. scripts/check-policy.ps1 is the authoritative validator and applies the merge rules: a project policy can only tighten the effective policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion"],
  "properties": {
    "$schema": { "type": "string" },
    "policyVersion": { "const": 1 },
    "organization": { "type": "string", "description": "Organization name. Only honored in an organization policy." },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "enum": ["strict", "legacy-safe", "api-service", "frontend", "mobile", "data", "infrastructure", "ai-application"] },
        "allowLegacySafe": { "type": "boolean" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "newCodeCoverageMin": { "type": "integer", "minimum": 0, "maximum": 100 },
        "newCodeDuplicationMax": { "type": "integer", "minimum": 0, "maximum": 100 },
        "blockingSeverities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "blocker" },
          "items": { "enum": ["blocker", "critical", "major", "minor"] }
        }
      }
    },
    "standards": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asvsLevel": { "type": "integer", "minimum": 1, "maximum": 3 },
        "wcagLevel": { "enum": ["A", "AA", "AAA"] }
      }
    },
    "bannedApis": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "reason"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "text": { "type": "string", "minLength": 2, "maxLength": 200, "description": "Literal text, not a regular expression." },
          "languages": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedRegistries": { "type": "array", "items": { "type": "string", "pattern": "^https://[^\\s/]+(/\\S*)?$" } },
        "requireApprovalForNew": { "type": "boolean" },
        "minimumReleaseAgeDays": { "type": "integer", "minimum": 0, "maximum": 365 }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireTicket": { "type": "boolean" },
        "ticketPattern": { "type": "string", "maxLength": 200, "description": "Only honored in an organization policy." }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sarif": { "type": "boolean" },
        "standardsTags": { "type": "boolean" }
      }
    }
  }
}
